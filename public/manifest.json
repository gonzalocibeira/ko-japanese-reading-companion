{
  "manifest_version": 3,
  "name": "Kō — Japanese Reading Companion",
  "short_name": "Kō",
  "version": "2.0.0",
  "version_name": "2.0.0",
  "description": "Offline Japanese readings, dictionary, grammar, and image lookup for webpages and Google Docs.",
  "permissions": [
    "storage",
    "offscreen",
    "activeTab"
  ],
  "commands": {
    "toggle-mascot": {
      "suggested_key": {"default":"Alt+Shift+K","mac":"Alt+Shift+K"},
      "description":"Call or hide Kōくん in this tab"
    },
    "photo-lookup": {
      "description":"Look up an image from this tab"
    }
  },
  "options_ui": {
    "page": "about.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-unavailable-16.png",
      "32": "icons/icon-unavailable-32.png",
      "48": "icons/icon-unavailable-48.png",
      "128": "icons/icon-unavailable-128.png"
    },
    "default_title": "Kō — checking this page"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "docs-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": [
        "art/mimetics/*.webp",
        "art/ko-kun/*.webp",
        "art/ko-kun/*.png",
        "art/ko-kun/index.json",
        "art/fonts/*.ttf"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https://en.wiktionary.org https://ja.wiktionary.org; worker-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
