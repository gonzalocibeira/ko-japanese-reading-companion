{"id":"n4-040","pattern":"急に（きゅうに）","aliases":["kyuu ni","きゅうに"],"level":"N4","purpose":"Describe an abrupt change or unexpected onset.","groups":["certainty"],"keywords":["certainty","express certainty uncertainty possibility expectations","急に + predicate.","It suddenly began to rain.","The room suddenly became dark.","The plan changed suddenly."],"comparisons":[],"formation":["急に + predicate."],"register":"Neutral","restrictions":"It emphasizes suddenness rather than necessarily urgency.","mistake":"Do not use 急に as the ordinary expression for doing a task quickly.","related":[],"examples":[{"segments":[{"text":"急に","role":"Describe an abrupt change or unexpected onset. 急に + predicate.","reading":"きゅうに"},{"text":"雨","reading":"あめ","lemma":"雨"},{"text":"が"},{"text":"降り","reading":"ふり","lemma":"降る"},{"text":"始め","reading":"はじめ"},{"text":"た"},{"text":"。"}],"translation":"It suddenly began to rain.","note":"Unexpected weather."},{"segments":[{"text":"部屋","reading":"へや","lemma":"部屋"},{"text":"が"},{"text":"急に","role":"Describe an abrupt change or unexpected onset. 急に + predicate.","reading":"きゅうに"},{"text":"暗く","reading":"くらく","lemma":"暗い"},{"text":"なっ","lemma":"なる"},{"text":"た"},{"text":"。"}],"translation":"The room suddenly became dark.","note":"An abrupt state change."},{"segments":[{"text":"予定","reading":"よてい","lemma":"予定"},{"text":"が"},{"text":"急に","role":"Describe an abrupt change or unexpected onset. 急に + predicate.","reading":"きゅうに"},{"text":"変わり","reading":"かわり","lemma":"変わる"},{"text":"まし"},{"text":"た"},{"text":"。"}],"translation":"The plan changed suddenly.","note":"An unexpected development."}]}
